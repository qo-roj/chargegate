# chargegate configuration — copy to the path CHARGEGATE_ENV_FILE points at
# (default ~/.config/chargegate/env) and fill in your values.

# Telegram bot token (alert channel). Get one from @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat ID the alerts go to (your user id — talk to @userinfobot).
CHARGEGATE_CHAT_ID=

# Short device name used in every alert message, e.g. "car-phone".
CHARGEGATE_DEVICE_LABEL=device

# Command that prints the sudo password on stdout (sysfs writes go through
# sudo). Default pulls from password-store. Devices with NOPASSWD sudo for
# the needed writes can set this to "true".
CHARGEGATE_SUDO_PASSWORD_CMD=pass show chargegate/sudo